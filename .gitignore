# Root gitignore for ShadowPulse

# Python virtual environments
venv/
.venv/
.venv-1/
backend/venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# SQLite/runtime data
*.db
*.sqlite
*.sqlite3
shadowpulse.db

# Local logs and runtime artifacts
*.log
backend/logs/
backend/captures/
backend/exports/

# Node / frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Local TODO / notes files
TODO.md
backend/TODO.md

# Environment files
.env
frontend/.env

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE/editor files
.vscode/
.idea/

# npm/yarn/pnpm debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
